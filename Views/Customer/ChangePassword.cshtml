@{
    ViewData["Title"] = "ChangePassword";
}
<link rel="stylesheet" href="~/css/ChangePassword.css" />
<link rel="stylesheet" href="~/css/HomeIndex.css" />

<div class="password-card">
    <h1 class="password-title">Đổi Mật Khẩu</h1>
    <p class="password-subtitle">
        Cập nhật mật khẩu để bảo mật tài khoản của bạn
    </p>

    <form id="changePasswordForm">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" for="currentPassword">
                Mật khẩu hiện tại <span class="required">*</span>
            </label>
            <input type="password"
                   id="currentPassword"
                   name="currentPassword"
                   class="form-input"
                   placeholder="Nhập mật khẩu hiện tại"
                   required>
        </div>

        <div class="form-group">
            <label class="form-label" for="newPassword">
                Mật khẩu mới <span class="required">*</span>
            </label>
            <input type="password"
                   id="newPassword"
                   name="newPassword"
                   class="form-input"
                   placeholder="Nhập mật khẩu mới"
                   required>
        </div>

        <div class="form-group">
            <label class="form-label" for="confirmPassword">
                Xác nhận mật khẩu mới <span class="required">*</span>
            </label>
            <input type="password"
                   id="confirmPassword"
                   name="confirmPassword"
                   class="form-input"
                   placeholder="Nhập lại mật khẩu mới"
                   required
                   oninput="checkPasswordMatch()">
            <div id="matchMessage" style="font-size: 12px; margin-top: 5px;"></div>
        </div>

        <div class="button-group">
            <button type="button" class="btn btn-secondary" onclick="cancelChange()">
                <i class="fas fa-times"></i>
                Hủy
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-key"></i>
                Đổi Mật Khẩu
            </button>
        </div>
    </form>
</div>

<script>
    // Check password match
    function checkPasswordMatch() {
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const matchMessage = document.getElementById('matchMessage');

        if (confirmPassword.length > 0) {
            if (newPassword === confirmPassword) {
                matchMessage.innerHTML = '<span style="color: #38a169;"><i class="fas fa-check"></i> Mật khẩu khớp</span>';
            } else {
                matchMessage.innerHTML = '<span style="color: #e53e3e;"><i class="fas fa-times"></i> Mật khẩu không khớp</span>';
            }
        } else {
            matchMessage.innerHTML = '';
        }
    }

    // Handle form submission với AJAX
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        // Validation phía client
        if (!currentPassword || !newPassword || !confirmPassword) {
            alert('Vui lòng điền đầy đủ thông tin!');
            return;
        }

        if (newPassword !== confirmPassword) {
            alert('Mật khẩu mới và xác nhận mật khẩu không khớp!');
            return;
        }

        if (newPassword.length < 8) {
            alert('Mật khẩu mới phải có ít nhất 8 ký tự!');
            return;
        }

        // Hiển thị loading
        const btn = document.querySelector('.btn-primary');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';
        btn.disabled = true;

        // Lấy anti-forgery token
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Gửi AJAX request
        fetch('@Url.Action("ChangePassword", "Customer")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: new URLSearchParams({
                currentPassword: currentPassword,
                newPassword: newPassword,
                confirmPassword: confirmPassword,
                __RequestVerificationToken: token
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Đổi mật khẩu thành công!');
                // Reset form
                document.getElementById('changePasswordForm').reset();
                document.getElementById('matchMessage').innerHTML = '';

                // Redirect về profile hoặc trang chủ sau 1 giây
                setTimeout(() => {
                    window.location.href = '@Url.Action("Profile", "Customer")';
                }, 1000);
            } else {
                alert(data.message || 'Có lỗi xảy ra!');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi kết nối với server!');
        })
        .finally(() => {
            // Khôi phục button
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    });

    // Cancel function
    function cancelChange() {
        if (confirm('Bạn có chắc muốn hủy thay đổi mật khẩu?')) {
            window.history.back();
        }
    }

    // Thêm validation realtime cho mật khẩu mới
    document.getElementById('newPassword').addEventListener('input', function() {
        const password = this.value;
        const currentPassword = document.getElementById('currentPassword').value;

        // Kiểm tra độ dài
        if (password.length > 0 && password.length < 8) {
            this.style.borderColor = '#e53e3e';
        } else if (password === currentPassword && password.length > 0) {
            this.style.borderColor = '#e53e3e';
        } else if (password.length >= 8) {
            this.style.borderColor = '#38a169';
        } else {
            this.style.borderColor = '';
        }

        // Cập nhật kiểm tra khớp mật khẩu
        checkPasswordMatch();
    });
</script>
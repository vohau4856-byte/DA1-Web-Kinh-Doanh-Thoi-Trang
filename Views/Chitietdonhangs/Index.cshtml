@model IEnumerable<DA1CNTT.Models.Chitietdonhang>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Soluong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Giadat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdDonhangNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdSanphamNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Soluong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Giadat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdDonhangNavigation.IdDonhang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdSanphamNavigation.IdSanpham)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdOrder">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdOrder">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdOrder">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

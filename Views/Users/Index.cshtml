@model IEnumerable<DA1CNTT.Models.User>

@{
    ViewData["Title"] = "QUAN LY NGUOI DUNG";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Quản lý người dùng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/AdminCSS.css" />
       
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
               
                  
               
                <strong>Admin</strong>
            </div>

            <nav class="sidebar-nav">
                <a href="~/Admin/Index" class="nav-item">
                    <i class="fas fa-tachometer-alt"></i>
                    Home
                </a>
                <a href="~/Users" class="nav-item active">
                    <i class="fas fa-users"></i>
                    Người dùng
                </a>
                <a href="~/SanPhams" class="nav-item">
                    <i class="fas fa-box"></i>
                    Sản phẩm
                </a>
                <a href="~/Loaisanphams" class="nav-item">
                    <i class="fas fa-chart-bar"></i>
                    Loại Sản Phẩm
                </a>
                <a href="~/Danhmucsanphams" class="nav-item">
                    <i class="fas fa-chart-bar"></i>
                    Danh Mục Sản Phẩm
                </a>
                <a href="~/Donhangs" class="nav-item">
                    <i class=" fas fa-shopping-cart"></i>
                    Đơn Hàng
                </a>
                <a href="~/Customer/Logout" class="nav-item">
                    <i class="fas fa-sign-out-alt"></i>
                    Đăng xuất
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="content-header">
                <h1 class="page-title">Quản lý người dùng</h1>
                <div class="user-info">
                    <div class="user-avatar">A</div>
                    <div>
                        <div style="font-weight: 600;">Admin</div>
                        <div style="font-size: 12px; color: #666;">Quản trị viên</div>
                    </div>
                </div>
            </div>

            <div class="content-body">
                <div class="section-header">
                    <h2 class="section-title">Quản lý người dùng</h2>
                    <button class="btn-primary">
                        <i class="fa-plus"> <a href="~/Users/Create" style="text-decoration: none;">Thêm người dùng</a></i>
                    </button>
                </div>

                <div class="table-container">
                    <table class="user-table">
                        <thead>
                            <tr>
                                <th>ID User</th>
                                <th>Tên</th>
                                <th>Tên Đăng Nhập</th>
                                <th>Mật Khẩu</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Vai trò</th>
                                
                                <th>Ngày tham gia</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                            <tr>
                                <td>
                                        @Html.DisplayFor(modelItem => item.IdUsers)
                                </td>
                                    <td>@Html.DisplayFor(modelItem => item.Tennguoidung)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Username)</td>
                                    <td>@Html.DisplayFor(modelItem => item.PasswordUsers)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>
                                        @Html.DisplayFor(modelItem => item.Phone)
                                </td>
                                    <td>@Html.DisplayFor(modelItem => item.Roles)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreateAt)</td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action btn-edit">
                                            <a href="~/Users/Edit/@item.IdUsers" style="text-decoration: none;"> <i class="fas fa-edit"></i></a>
                                        </button>
                                        <button class="btn-action btn-delete">
                                                <a href="~/Users/Delete/@item.IdUsers" style="text-decoration: none;">  <i class="fas fa-trash" style="text-decoration: none;"></i></a>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                          }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</body>
</html>



